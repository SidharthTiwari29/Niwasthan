model MarketPriceObservation {
  id                    String   @id
  sourceProductId       String
  observedAt            DateTime
  amountMinor           BigInt
  listAmountMinor       BigInt?
  currency              String   @default("INR")
  unit                  String
  taxIncluded           Boolean?
  shippingIncluded      Boolean?
  installationIncluded  Boolean?
  // Structured, not buried in the unstructured `evidence`/attribute Json
  // blobs elsewhere in this model - the exact "unstructured Json with no
  // guaranteed shape" problem already flagged and fixed for
  // RoomUnderstanding.dimensions this session. Warranty terms genuinely
  // vary by source/listing (the same canonical product sold by two
  // vendors can carry different warranty terms), so this lives on the
  // observation, not the canonical MarketProduct - and null means
  // "warranty status unknown for this observation," never silently
  // "no warranty" (see evaluateSourceQuality, which treats these two
  // cases differently rather than collapsing them).
  warrantyMonths        Int?
  location              Json?
  availability          String?
  evidence              Json
  retrievalMethod       String
  confidenceBps         Int?
