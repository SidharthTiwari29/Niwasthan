enum SubstitutionImpact {
  IMPROVED
  SAME
  REDUCED
  UNKNOWN
}

// Curated, evidence-backed alternative relationship (README §8 ALTERNATIVE_TO).
// Complementary to marketIntelligence/substitution.ts's pure ranking logic:
// that module ranks candidate offers by computed score, this model records
// a human (admin/designer) explicitly stating a trade-off, since quality/
// maintenance/durability impact cannot be honestly auto-derived without a
// material-attribute schema this system doesn't have.
model CatalogueSubstitution {
  id                  String             @id @default(cuid())
  fromCatalogueItemId String
  toCatalogueItemId   String
  qualityImpact       SubstitutionImpact @default(UNKNOWN)
  maintenanceImpact   SubstitutionImpact @default(UNKNOWN)
  appearanceImpact    SubstitutionImpact @default(UNKNOWN)
  durabilityImpact    SubstitutionImpact @default(UNKNOWN)
  explanation         String             @db.Text
  createdByUserId     String
  createdAt           DateTime           @default(now())
  fromCatalogueItem   CatalogueItem      @relation("SubstitutionFrom", fields: [fromCatalogueItemId], references: [id])
  toCatalogueItem     CatalogueItem      @relation("SubstitutionTo", fields: [toCatalogueItemId], references: [id])
  createdBy           User               @relation(fields: [createdByUserId], references: [id])

  @@unique([fromCatalogueItemId, toCatalogueItemId])
  @@index([fromCatalogueItemId])
}

enum ProcurementRequestStatus {
  DRAFT
  RFQ_SENT
  QUOTES_RECEIVED
  ORDERED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ExecutionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SNAGGED
  RESOLVED
}

// README §26: RFQ -> Quote Comparison -> Order -> Delivery. Only begins
// from a locked BudgetPlan (the real budget system, in BudgetPlan/
// BudgetVersion - queried via raw SQL by procurementRepository since those
// tables have no typed Prisma model here). lockedBudgetPlanId/
// lockedBudgetVersion are plain scalar references rather than a Prisma
// relation for that reason - the FK integrity for that side is enforced
// by the service layer's lock check, not the database schema.
model ProcurementRequest {
  id                  String                   @id @default(cuid())
  propertyId          String
  ownerId             String
  lockedBudgetPlanId  String
  lockedBudgetVersion Int
  status              ProcurementRequestStatus @default(DRAFT)
  idempotencyKey      String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  property            Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner               User                     @relation(fields: [ownerId], references: [id])
  quotes              Quote[]
  orders              Order[]
  supplierInvites     SupplierInvite[]

  @@unique([propertyId, idempotencyKey])
}

model Quote {
  id                   String             @id @default(cuid())
  procurementRequestId String
  supplierName         String
  totalAmountMinor     BigInt
  currency             String             @default("INR")
  status               QuoteStatus        @default(SUBMITTED)
  validUntil           DateTime?
  notes                String?            @db.Text
  // Nivasa's commission and minimum-acceptable-margin are fixed at
  // submission time, not recomputed later - this is the actual mechanism
  // that keeps negotiation profitable: minMarginBps defines the floor
  // percentage of totalAmountMinor that must remain as Nivasa's margin no
  // matter how a negotiation ends, so a user can never negotiate away more
  // than the business decided it could afford to give up when the quote
  // was first accepted into the system.
  nivasaCommissionBps  Int                @default(1000)
  minMarginBps         Int                @default(500)
  createdAt            DateTime           @default(now())
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  order                Order?
  negotiations         QuoteNegotiation[]

  @@index([procurementRequestId, status])
}

model Order {
  id                   String             @id @default(cuid())
  procurementRequestId String
  quoteId              String             @unique
  status               OrderStatus        @default(PLACED)
  totalAmountMinor     BigInt
  currency             String             @default("INR")
  placedAt             DateTime           @default(now())
  deliveredAt          DateTime?
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id])
  quote                Quote              @relation(fields: [quoteId], references: [id])
  executions           ExecutionRecord[]

  @@index([procurementRequestId])
}

model ExecutionRecord {
  id            String          @id @default(cuid())
  orderId       String
  status        ExecutionStatus @default(SCHEDULED)
  scheduledDate DateTime?
  completedAt   DateTime?
  snagNotes     String?         @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  QUOTE_RECEIVED
  EXECUTION_STATUS_CHANGED
  BUDGET_LOCKED
  GENERAL
  // README §30 Niwasthan Moments - real, useful project events given
  // personality-infused framing (see momentTemplates.ts), never replacing
  // the underlying factual notification, only adding brand voice to it.
  PRICE_DROP
  BETTER_ALTERNATIVE_FOUND
  BUDGET_EXCEEDED
  DESIGN_APPROVED
  WALKTHROUGH_READY
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String           @db.Text
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

enum NegotiationDecision {
  ACCEPTED
  COUNTERED
  REJECTED
}

// The floor logic that keeps negotiation profitable for Nivasa is defined
// entirely on the Quote itself, set at quote-submission time - not derived
// ad hoc at negotiation time - so the floor a user negotiates against can
// never be changed retroactively to move the goalposts mid-negotiation.
model QuoteNegotiation {
  id                  String              @id @default(cuid())
  quoteId             String
  proposedAmountMinor BigInt
  decision            NegotiationDecision
  counterAmountMinor  BigInt?
  createdAt           DateTime            @default(now())
  quote               Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

enum ReferralStatus {
  PENDING
  REWARDED
  EXPIRED
}

// Every user gets exactly one stable referral code (their own invite
// link). A referral only pays out once the referred user completes a
// real, revenue-generating action (an Order actually delivered) - not on
// sign-up alone, which would be trivially gameable by creating throwaway
// accounts.
model ReferralCode {
  id          String     @id @default(cuid())
  ownerUserId String     @unique
  code        String     @unique
  createdAt   DateTime   @default(now())
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

model Referral {
  id               String         @id @default(cuid())
  referralCodeId   String
  referredUserId   String         @unique
  status           ReferralStatus @default(PENDING)
  triggeringOrderId String?
  bonusCredits     Int?
  rewardedAt       DateTime?
  createdAt        DateTime       @default(now())
  referralCode     ReferralCode   @relation(fields: [referralCodeId], references: [id])
  referredUser     User           @relation(fields: [referredUserId], references: [id])

  @@index([referralCodeId, status])
}

// Suppliers are external parties who never need a full platform account -
// building a parallel user/auth system for occasional quote submission
// would be significant unnecessary scope. Instead, access is a signed,
// single-use, time-limited token: the raw token is emailed/shared once
// and never stored - only its SHA-256 hash is persisted, so a database
// read can never leak a usable credential (the same principle as never
// storing a plaintext password).
model SupplierInvite {
  id                    String              @id @default(cuid())
  procurementRequestId  String
  supplierName          String
  tokenHash             String              @unique
  expiresAt             DateTime
  usedAt                DateTime?
  quoteId               String?
  createdByUserId       String
  createdAt             DateTime            @default(now())
  procurementRequest    ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  createdBy             User                @relation(fields: [createdByUserId], references: [id])

  @@index([procurementRequestId])
}

// The trust-building mechanism: every user gets exactly one HD-quality
// visualization for free, regardless of their plan - a bounded,
// per-user, one-time cost (not per-transaction margin erosion) meant to
// let a prospective customer see genuinely great output before they've
// paid anything, which is the actual conversion lever, not a recurring
// discount. Tracked as its own row (not a boolean flag on User) so the
// grant is auditable: which asset it produced, when it was used.
model OnboardingRenderGrant {
  id         String    @id @default(cuid())
  userId     String    @unique
  usedAt     DateTime?
  assetId    String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The real, persisted form of a catalogueCuration.ts result - closes the
// exact gap the architecture review found: curateWithinBudget previously
// produced a throwaway suggestion with nowhere to go. This is the
// concrete demonstration of the canonical DecisionStatus lifecycle:
// RECOMMENDED when first generated (shown to the user, not yet costed
// into any real BOQ), COMMITTED once the user accepts it and a real Boq
// is created from it. Never silently skips RECOMMENDED - committing
// requires an explicit prior recommendation to commit, by construction
// (commitCuration takes a recommendationId, not raw selection data).
model CurationRecommendation {
  id              String         @id @default(cuid())
  ownerId         String
  projectId       String
  status          DecisionStatus @default(RECOMMENDED)
  targetBudgetMinor BigInt
  selections      Json
  totalMinor      BigInt
  resultingBoqId  String?
  createdAt       DateTime       @default(now())
  committedAt     DateTime?
  owner           User           @relation(fields: [ownerId], references: [id])
  project         DesignProject  @relation(fields: [projectId], references: [id])

  @@index([projectId, status])
}

// Real, persisted state for the plan-upgrade discount offer: how many
// times this specific customer has genuinely returned to this specific
// upgrade offer after the previous one expired, and when the current
// offer's 4-hour window began. visitNumber only increments when a new
// visit is recorded AFTER the previous offer's window has expired -
// refreshing the page within an active window returns the SAME offer,
// never advances the discount tier. Without this rule, a customer could
// trivially refresh repeatedly to instantly reach the maximum discount,
// defeating the entire point of a visit-based, time-boxed incentive.
model PlanUpgradeOffer {
  id                String   @id @default(cuid())
  userId            String
  targetPackageCode String
  visitNumber       Int      @default(1)
  offerShownAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetPackageCode])
}

// Real, additive foundation for docs/AGENTIC-OPERATIONS.md section 5
// (Operational event model) - the FACTS layer every specialist agent,
// the audit trail, and the incident lifecycle described there depend
// on. Deliberately just facts: an event records that something real
// happened, exactly as the domain service that emitted it observed it
// - never an agent's interpretation, hypothesis, or decision about
// that fact (those are separate, not-yet-built layers per the same
// document's section 8, and must never be recorded here or allowed to
// overwrite what actually happened).
enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model OperationalEvent {
  id            String        @id @default(cuid())
  // A real, specific event type from the vocabulary the spec itself
  // defines (e.g. "FLOOR_PLAN_ANALYSIS_FAILED") - a plain string
  // rather than a Prisma enum, since the spec's own event list is
  // explicitly described as "examples" and will keep growing as more
  // domain services are wired in; a database migration should never be
  // required just to add a new, real event type.
  type          String
  occurredAt    DateTime      @default(now())
  actorType     String?
  actorId       String?
  userId        String?
  propertyId    String?
  projectId     String?
  // Ties together every event produced by a single real, end-to-end
  // operation (e.g. one floor-plan analysis run) even when it spans
  // several individual events (STARTED, then either FAILED or a
  // downstream event) - the spec's own "correlation ID" field.
  correlationId String?
  // The specific event (if any) that directly caused this one - the
  // spec's own "causation ID" field, distinct from correlationId:
  // several events can share one correlation ID (the same overall
  // operation) while each still has its own, more specific cause.
  causationId   String?
  domainType    String?
  domainId      String?
  severity      EventSeverity @default(INFO)
  currentState  String?
  previousState String?
  // Real, structured detail about this specific event - deliberately
  // named "metadata" to match the spec's own "safe metadata" field,
  // and deliberately never used to store anything the rest of this
  // schema already treats as sensitive (matching this project's
  // existing privacy conventions elsewhere).
  metadata      Json?

  @@index([type, occurredAt])
  @@index([correlationId])
  @@index([propertyId])
  @@index([projectId])
  @@index([userId])
}

// Real, additive model for docs/AGENTIC-OPERATIONS.md section 9
// (Incident lifecycle) and section 16 (AgentIncident, one of the
// required future domain primitives). Deliberately a real, deterministic
// record of a detected problem - never a fabricated "everything is
// fine" default and never auto-resolved without a real, subsequent
// event confirming the underlying condition actually cleared. Nothing
// in this schema or the code that writes to it yet performs autonomous
// remediation (spec section 7's classes B/C/D) - this is the DETECTED
// state and the human-visible lifecycle around it, not an agent acting
// on its own.
enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  DIAGNOSING
  ACTION_PLANNED
  ACTION_EXECUTED
  VERIFYING
  RESOLVED
  ESCALATED
  REMEDIATED
  VERIFIED
}

model AgentIncident {
  id                     String         @id @default(cuid())
  status                 IncidentStatus @default(DETECTED)
  severity               EventSeverity
  // The real workflow/capability this incident affects, in the same
  // vocabulary as OperationalEvent.type (e.g. "FLOOR_PLAN_ANALYSIS") -
  // deliberately a plain string for the same reason: the real set of
  // affected capabilities will keep growing as more domain services
  // are wired into the event model, and that should never require a
  // migration.
  affectedCapability     String
  propertyId             String?
  projectId              String?
  userId                 String?
  // The real event that caused this incident to be detected - the
  // actual evidence, not a summary or a guess about what happened.
  triggeringEventId      String?
  firstDetectedAt        DateTime       @default(now())
  acknowledgedAt         DateTime?
  resolvedAt             DateTime?
  // A real, explicit classification once genuinely known - null until
  // then, never a placeholder guess standing in for real diagnosis.
  rootCauseClassification String?
  // How many times this exact same real condition has been detected
  // before - a real, counted fact, not an estimate.
  recurrenceCount        Int            @default(1)
  preventionRecommendation String?      @db.Text
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status, severity])
  @@index([affectedCapability])
  @@index([propertyId])
}
