  termsReference       String?
  licensingStatus      String?
  ingestionEligible    Boolean  @default(false)
  freshnessPolicyHours Int?
  provenancePolicy     String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime

  @@index([sourceType, active])
  @@index([ingestionEligible, active])
}

model MarketVendor {
  id              String   @id
  sourceId        String
  canonicalName   String
  brandName       String?
  sellerType      String
  sellerReference String?
  geography       Json?
