generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The canonical lifecycle every AI/system-generated recommendation must
// pass through before it can affect committed money, BOQ, or a locked
// decision - the single most important structural rule in this system,
// enforcing the "no fabricated certainty" principle at the schema level
// rather than leaving it to per-feature discipline.
//
// INFERRED    - raw AI/system output, confidence-scored, not yet shown
//               as an actionable suggestion.
// RECOMMENDED - shown to the user, reversible, NOT yet costed into any
//               committed BOQ/budget total.
// COMMITTED   - the user explicitly accepted this; now real, versioned,
//               attributable, and counted in real totals.
// LOCKED      - immutable until the user explicitly unlocks it; the
//               Revision Impact Engine must never silently rewrite a
//               LOCKED row.
//
// New decision-like tables (an AI/system suggestion the user must review
// before it becomes real) should use this enum rather than inventing a
// bespoke status - existing tables with their own established status
// enums (RoomUnderstandingStatus, QuoteStatus, etc.) are NOT retrofitted
// to this by default, since a mass rename across already-shipped, tested
// code carries real regression risk for no user-facing benefit. Adopt
// this going forward; migrate an existing table only when there's a
// concrete reason tied to real, needed behavior change.
enum DecisionStatus {
  INFERRED
  RECOMMENDED
  COMMITTED
  LOCKED
}

enum CatalogueAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

// Real, manufacturer-specified connectivity types for smart-home/lighting
// products - not an invented capability list. NONE is the correct value
// for any ordinary, non-connected product, distinct from null (which
// means "not applicable/not yet recorded" for a product outside this
// domain entirely).
enum SmartHomeConnectivity {
  BLUETOOTH
  WIFI
  ZIGBEE
  MATTER
  NONE
}

enum Role {
  USER
  DESIGNER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobType {
  ROOM_UNDERSTANDING
  DESIGN_GENERATION
  DESIGN_REVISION
  THREE_D_SCENE
  PANORAMA
  WALKTHROUGH
  VIDEO
}

enum AssetType {
  FLOOR_PLAN
  ROOM_IMAGE
  DESIGN_IMAGE
  PANORAMA
  THREE_D_SCENE
  WALKTHROUGH
  VIDEO
  OTHER
}

enum PurchaseStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  RESERVED
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum BoqStatus {
  DRAFT
  FINALIZED
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  BALCONY
  STUDY
  OTHER
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  OTHER
}

enum RoomUnderstandingSource {
  AI
  USER
  IMPORTED
}

enum RoomUnderstandingStatus {
  UNCONFIRMED
  CONFIRMED
  CORRECTED
  NEEDS_REVIEW
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  image                      String?
  role                       Role                  @default(USER)
  // Real, honest fraud-risk signals captured at signup - NOT a claim of
  // true device fingerprinting or VPN detection, which would need a paid
  // third-party IP-intelligence service this system doesn't have. IP
  // address and User-Agent are real, cheaply-observable signals with
  // real, known limitations (shared home/office/mobile-carrier IPs
  // produce false positives; a VPN or incognito window defeats this
  // signal entirely). This is used as ONE input to a graduated,
  // human-reviewable risk flag, never as an automatic, high-confidence
  // fraud verdict - see referralFraudSignal.ts for the honest scope of
  // what this can and cannot detect.
  signupIpAddress            String?
  signupUserAgent            String?               @db.Text
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  properties                 Property[]
  projects                   DesignProject[]
  purchases                  Purchase[]
  entitlements               Entitlement[]
  auditLogs                  AuditLog[]
  confirmedHomeIntelligences HomeIntelligence[]    @relation("HomeIntelligenceConfirmedBy")
  confirmedRoomUnderstandings RoomUnderstanding[] @relation("RoomUnderstandingConfirmedBy")
  createdHomeDnaVersions     HomeDnaVersion[]      @relation("HomeDnaCreatedBy")
  createdCatalogueSubstitutions CatalogueSubstitution[]
  procurementRequests        ProcurementRequest[]
  notifications              Notification[]
  ownReferralCode            ReferralCode?
  referralAsReferred         Referral?
  createdSupplierInvites     SupplierInvite[]
  onboardingRenderGrant      OnboardingRenderGrant?
  curationRecommendations    CurationRecommendation[]
  verifiedCataloguePrices    CataloguePrice[] @relation("CataloguePriceVerifiedBy")
  curatedBrands              Brand[] @relation("BrandCuratedBy")
  planUpgradeOffers          PlanUpgradeOffer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PropertyBhkType {
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  VILLA
  OTHER
}

model Property {
  id               String             @id @default(cuid())
  ownerId          String
  name             String
  address          String?
  // Real, additive fields for the actual onboarding flow - captured
  // upfront so the customer states them once, rather than being asked
  // again later. None of these substitute for the real, AI-analyzed or
  // manually-confirmed room dimensions that remain the actual source of
  // spatial truth (RoomUnderstanding) - city and property type describe
  // the home in general terms; they do not claim to be measured.
  city             String?
  propertyType     PropertyBhkType?
  // The customer's own stated target budget for this home, captured at
  // onboarding so it can be reused as the real default when generating
  // a BOQ later, rather than asked for twice. Still just a stated
  // intent, not a commitment - the real, itemized BOQ total is computed
  // separately and can differ from this figure.
  targetBudgetMinor BigInt?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            User               @relation(fields: [ownerId], references: [id])
  floorPlans       FloorPlan[]
  rooms            Room[]
  projects         DesignProject[]
  homeIntelligence HomeIntelligence?
  homeDnaVersions  HomeDnaVersion[]
  procurementRequests ProcurementRequest[]
  assets           Asset[]

  @@index([ownerId, createdAt])
}

model HomeIntelligence {
  id                 String       @id @default(cuid())
  propertyId         String       @unique
  version            Int          @default(1)
  propertyType       PropertyType
  configuration      String?
  possessionDate     DateTime?
  city               String?
  state              String?
  country            String       @default("India")
  carpetAreaSqFt     Decimal?     @db.Decimal(12, 2)
  metadata           Json?
  confirmedAt        DateTime?
  confirmedByUserId  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  property           Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  confirmedBy        User?        @relation("HomeIntelligenceConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([confirmedByUserId])
}

model HomeDnaVersion {
  id                      String   @id @default(cuid())
  propertyId              String
  version                 Int
  homeIntelligenceVersion Int
  household               Json
  lifestyle               Json
  designPersonality       Json
  storageNeeds            Json
  functionalNeeds         Json
  futureNeeds             Json
  smartHomePreferences    Json
  language                String   @default("en-IN")
  createdByUserId         String
  createdAt               DateTime @default(now())
  property                Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy               User     @relation("HomeDnaCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([propertyId, version])
  @@index([propertyId, createdAt])
  @@index([createdByUserId])
}

model FloorPlan {
  id         String   @id @default(cuid())
  propertyId String
  version    Int      @default(1)
  assetId    String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  asset      Asset    @relation(fields: [assetId], references: [id])
  analyses   FloorPlanAnalysis[]

  @@unique([propertyId, version])
  @@index([propertyId])
}

enum FloorPlanAnalysisStatus {
  PENDING
  ANALYZED
  NOT_AVAILABLE
  FAILED
}

// Real, additive evidence layer - deliberately separate from
// RoomUnderstanding. This records what an AI provider actually
// detected in a floor plan, before any of it becomes spatial truth.
// The distinction matters: a FloorPlanObservation is raw, unconfirmed
// evidence tied to a detected label (the AI's own name for a room it
// found), not yet linked to any real Room record. Only once a human
// reviews an observation and matches it to a real Room does it inform
// that Room's own RoomUnderstanding - AI proposes, a human confirms,
// exactly the same principle already enforced everywhere else in this
// schema (RoomUnderstanding.status, CataloguePrice.verifiedAt).
model FloorPlanAnalysis {
  id            String                  @id @default(cuid())
  floorPlanId   String
  status        FloorPlanAnalysisStatus @default(PENDING)
  parserVersion String?
  requestedAt   DateTime                @default(now())
  completedAt   DateTime?
  // The real, honest reason when status is NOT_AVAILABLE or FAILED -
  // e.g. "no AI provider is configured yet" - never left blank when
  // analysis didn't genuinely succeed.
  reason        String?
  floorPlan     FloorPlan               @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  observations  FloorPlanObservation[]

  @@index([floorPlanId])
}

model FloorPlanObservation {
  id            String            @id @default(cuid())
  analysisId    String
  // The AI's own detected label for this room ("Master Bedroom"), not
  // a real Room's name - those are two different things until a human
  // confirms they refer to the same real space.
  roomLabel     String
  confidenceBps Int?
  // Same real, validated shape as RoomUnderstanding.dimensions -
  // deliberately kept structurally identical so mapping a confirmed
  // observation into a real RoomUnderstanding is a direct copy, not a
  // translation.
  dimensions    Json?
  // Real evidence coordinates on the source floor-plan image/page
  // where this observation was detected (e.g. a bounding box or
  // polygon in image-relative coordinates) - null until a real,
  // configured provider actually supplies this, never a placeholder
  // or estimated region.
  sourceRegion  Json?
  // Set only once a human has reviewed this observation and confirmed
  // which real Room it actually corresponds to - null until then, so
  // an unmatched observation is never silently treated as belonging to
  // a specific real room.
  matchedRoomId String?
  // A real, explicit human decision that this observation does NOT
  // correspond to any real room (a misread, a duplicate, a non-room
  // space the AI mistakenly detected) - distinct from simply not
  // having been reviewed yet, so the review workspace can tell "not
  // looked at" apart from "looked at and dismissed."
  rejected      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  analysis      FloorPlanAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  matchedRoom   Room?             @relation(fields: [matchedRoomId], references: [id])

  @@index([analysisId])
  @@index([matchedRoomId])
}

model Room {
  id                String               @id @default(cuid())
  propertyId        String
  type              RoomType
  name              String
  areaSqFt          Decimal?             @db.Decimal(12, 2)
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  property          Property             @relation(fields: [propertyId], references: [id])
  projects          DesignProject[]
  roomUnderstandings RoomUnderstanding[]
  matchedFloorPlanObservations FloorPlanObservation[]

  @@index([propertyId])
}

model RoomUnderstanding {
  id                String                  @id @default(cuid())
  roomId            String
  version           Int
  roomType          RoomType
  name              String
  confidenceBps     Int?
  source            RoomUnderstandingSource
  geometry          Json?
  dimensions        Json?
  constraints       Json?
  requirements      Json?
  status            RoomUnderstandingStatus @default(UNCONFIRMED)
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime                @default(now())
  room              Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  confirmedBy       User?                   @relation("RoomUnderstandingConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@unique([roomId, version])
  @@index([roomId, createdAt])
  @@index([confirmedByUserId])
}

// The real "one active direction, unlimited alternatives explored,
// nothing deleted" invariant: a customer can explore several style
// directions (Warm Contemporary, Japandi, Modern Luxury) for the same
// property, but only ONE can be the ACTIVE direction that actually
// feeds BOQ/budget/procurement at any given time. Deliberately additive
// to the existing DesignProject/DesignVersion chain rather than a
// parallel architecture - a direction is a real grouping layer between
// a project and its versions, not a competing concept.
//
// The one-active-at-a-time invariant is enforced at the application
// layer via a real transaction (see designDirectionService.activate),
// not by a database constraint alone - Prisma's schema DSL has no clean
// way to express "unique only when status = ACTIVE" without raw SQL,
// and the transaction-based approach is the same "conditional update,
// not read-then-write" discipline already used throughout this
// codebase for exactly this class of invariant.
enum DesignDirectionStatus {
  ACTIVE
  ALTERNATIVE
  REJECTED
}

model DesignDirection {
  id          String                @id @default(cuid())
  projectId   String
  name        String
  status      DesignDirectionStatus @default(ALTERNATIVE)
  // The customer's own stated reason, captured when they reject a
  // direction - real, structured feedback that can seed the NEXT
  // exploration, rather than a direction simply vanishing with no
  // record of why it didn't work for them.
  rejectionReason String?           @db.Text
  createdAt   DateTime              @default(now())
  activatedAt DateTime?
  project     DesignProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    DesignVersion[]

  @@index([projectId, status])
}

model DesignProject {
  id         String        @id @default(cuid())
  ownerId    String
  propertyId String
  roomId     String?
  name       String
  status     ProjectStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  owner      User          @relation(fields: [ownerId], references: [id])
  property   Property      @relation(fields: [propertyId], references: [id])
  room       Room?         @relation(fields: [roomId], references: [id])
  versions   DesignVersion[]
  revisions  DesignRevision[]
  jobs       AIJob[]
  boqs       Boq[]
  curationRecommendations CurationRecommendation[]
  directions DesignDirection[]

  @@index([ownerId, createdAt])
  @@index([propertyId])
}

model DesignVersion {
  id         String        @id @default(cuid())
  projectId  String
  // Nullable and additive - existing versions created before this
  // feature existed have no direction, and remain valid exactly as
  // they are. New versions are expected to be created within a real
  // direction going forward.
  directionId String?
  version    Int
  prompt     String?       @db.Text
  parameters Json?
  createdAt  DateTime      @default(now())
  project    DesignProject @relation(fields: [projectId], references: [id])
  direction  DesignDirection? @relation(fields: [directionId], references: [id])
  assets     Asset[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([directionId])
}

model DesignRevision {
  id             String        @id @default(cuid())
  projectId      String
  baseVersionId  String
  revisionNumber Int
  instruction    String        @db.Text
  parameters     Json?
  createdAt      DateTime      @default(now())
  project        DesignProject @relation(fields: [projectId], references: [id])

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
}

model Asset {
  id              String         @id @default(cuid())
  type            AssetType
  objectKey       String         @unique
  contentType     String
  sizeBytes       BigInt?
  checksum        String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  floorPlans      FloorPlan[]
  designVersionId String?
  designVersion   DesignVersion? @relation(fields: [designVersionId], references: [id])
  jobId           String?
  job             AIJob?         @relation(fields: [jobId], references: [id])
  // A floor plan (and other genuinely property-level uploads) has no
  // design version or AI job yet - it is typically the very first real
  // asset attached to a property, before any design work exists.
  propertyId      String?
  property        Property?      @relation(fields: [propertyId], references: [id])

  @@index([type, createdAt])
  @@index([jobId])
  @@index([propertyId])
}

model AIJob {
  id             String        @id @default(cuid())
  projectId      String
  type           JobType
  status         JobStatus     @default(QUEUED)
  idempotencyKey String
  provider       String?
  providerJobId  String?
  // Links this job to the exact CreditReservation it consumed, so the
  // worker's terminal-state transition can confirm (on success) or
  // release (on failure) the SAME reservation - never a different one,
  // never none at all. Without this link, credit consumption and job
  // outcome would be two independent systems with no way to keep them
  // honest with each other.
  creditReservationId String?
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?       @db.Text
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  project        DesignProject @relation(fields: [projectId], references: [id])
  assets         Asset[]

  @@unique([projectId, idempotencyKey])
  @@index([status, createdAt])
  @@index([provider, providerJobId])
}

// The real, hierarchical taxonomy Niwasthan's own vision document
// specifies (Product Family -> Category -> Subcategory -> Product Type,
// e.g. "Furniture > Sofa > 2 Seater") - a proper tree, not a flat string
// tag. Self-referencing so it supports arbitrary depth without a schema
// change every time a new level is needed. Seeded ONLY with the 18 real
// top-level product families explicitly specified - subcategories are
// added incrementally by real admin curation as the catalogue actually
// grows, never fabricated in bulk to look complete.
model ProductCategory {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  parentId     String?
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryHierarchy")
  catalogueItems CatalogueItem[]

  @@index([parentId])
}

// First-class Brand entity, not a bare string on CatalogueItem - this is
// what makes "which brands are best for my 8 lakh kitchen" a real,
// queryable question rather than a string-matching guess.
//
// Deliberately split into two trust tiers:
// - Factual fields (name, website) are plain data, no attestation needed.
// - Narrative fields (positioning, strengths, weaknesses) are a genuine
//   curator's written assessment, not an AI-computed score - attributed
//   and dated the same way catalogue price verification is, because a
//   claim like "good service network" is a real-world judgment call that
//   needs a real, accountable person standing behind it, not a
//   confidence percentage pretending to replace one.
model Brand {
  id                String          @id @default(cuid())
  name              String          @unique
  website           String?
  curatedPositioning String?        @db.Text
  curatedStrengths  String?         @db.Text
  curatedWeaknesses String?         @db.Text
  curatedByUserId   String?
  curatedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  curatedBy         User?           @relation("BrandCuratedBy", fields: [curatedByUserId], references: [id])
  catalogueItems    CatalogueItem[]

  @@index([curatedByUserId])
}

model CatalogueItem {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  brand       String?
  // Both new fields are nullable and additive - existing rows using the
  // plain `brand` string and flat `category` string keep working
  // unchanged. A CatalogueItem migrates onto the real Brand/ProductCategory
  // entities as it's genuinely curated, not all at once in a risky mass
  // rewrite.
  brandId           String?
  productCategoryId String?
  description String?          @db.Text
  category    String
  unit        String
  // Real, direct product image URL from the manufacturer/dealer source
  // page that published it - never a generated or placeholder image.
  // Null means no real image URL was found for this item, not "use a
  // stock photo" - the customer-facing UI must handle a missing image
  // honestly rather than fabricate one.
  imageUrl    String?
  // The real source page this item's specification/pricing was
  // verified against - lets a curator or customer trace a listing back
  // to its actual origin, matching this catalogue's own sourcing
  // discipline (see the bulk-import research standard).
  sourceUrl   String?
  // A real, editorial positioning tier (e.g. Economy/Standard/Premium/
  // Luxury) as assigned by whoever curated this row - not a
  // manufacturer-issued rating. Deliberately a plain string, not an
  // enum: the real, evolving set of tiers used across very different
  // categories (plywood vs. smart toilets) shouldn't be constrained to
  // a fixed list decided ahead of time.
  qualityTier String?
  // A real, editorial score out of 5 reflecting documented fit,
  // specification strength, and value for Indian interior use - not a
  // manufacturer claim, and never fabricated when no real assessment
  // was made (null, not a default, when absent from the source data).
  niwasthanRating Decimal?     @db.Decimal(3, 2)
  // Real, manufacturer-published, objectively verifiable specs -
  // relevant specifically to Home Automation family products (README
  // family #11) and lighting, not fabricated claims about smart
  // capability. smartHomeConnectivity is null for any product that
  // simply isn't a connected device; energyRatingStars uses India's real
  // BEE (Bureau of Energy Efficiency) star rating scale actually printed
  // on real appliance/lighting packaging, not an invented scale.
  smartHomeConnectivity SmartHomeConnectivity?
  energyRatingStars      Int?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  prices      CataloguePrice[]
  boqLines    BoqLine[]
  substitutionsFrom CatalogueSubstitution[] @relation("SubstitutionFrom")
  substitutionsTo   CatalogueSubstitution[] @relation("SubstitutionTo")
  brandRef          Brand?           @relation(fields: [brandId], references: [id])
  productCategoryRef ProductCategory? @relation(fields: [productCategoryId], references: [id])

  @@index([brandId])
  @@index([productCategoryId])
}

model CataloguePrice {
  id            String        @id @default(cuid())
  itemId        String
  // MRP is the listed maximum retail price - what's printed on the
  // brand's own pricing, often higher than what's actually charged.
  // amountMinor remains the actual selling price used in real BOQ/budget
  // arithmetic; mrpMinor is optional (some sources genuinely have no
  // separate MRP concept) and is never used for financial calculations
  // itself - it exists to let the curation engine and customer-facing
  // display show "MRP vs actual price" transparently, matching real
  // Indian retail convention, without ever substituting one for the other.
  mrpMinor      BigInt?
  amountMinor   BigInt
  currency      String        @default("INR")
  // Same rationale as MarketPriceObservation.warrantyMonths - structured,
  // not buried in unstructured Json, and null means "unknown," never
  // silently "none". This is the field the customer-facing curation
  // engine (catalogueCuration.ts) actually reads to enforce real
  // warranty-quality gating before a customer ever sees an option.
  warrantyMonths Int?
  // Structured, not buried in unstructured Json - real stock status a
  // customer can trust, distinct from a listing simply existing.
  availability  CatalogueAvailability @default(UNKNOWN)
  // The real, honest version of a "verified" badge: an explicit human
  // attestation, not a marketing label. verifiedByUserId/verifiedAt are
  // both null until a real admin/curator has actually checked this
  // specific listing's price, warranty, and availability against its
  // source and confirms it's accurate as of that date - this is an
  // audit trail, not a computed score, since "a human checked this" is
  // fundamentally a fact about an event that happened, not something
  // derivable from the data alone.
  verifiedByUserId String?
  verifiedAt       DateTime?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  item          CatalogueItem @relation(fields: [itemId], references: [id])
  verifiedBy    User?         @relation("CataloguePriceVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([itemId, effectiveFrom])
}

model Boq {
  id            String        @id @default(cuid())
  projectId     String
  version       Int           @default(1)
  status        BoqStatus     @default(DRAFT)
  currency      String        @default("INR")
  subtotalMinor BigInt        @default(0)
  taxMinor      BigInt        @default(0)
  discountMinor BigInt        @default(0)
  wastageMinor  BigInt        @default(0)
  totalMinor    BigInt        @default(0)
  snapshot      Json
  createdAt     DateTime      @default(now())
  project       DesignProject @relation(fields: [projectId], references: [id])
  lines         BoqLine[]

  @@unique([projectId, version])
}

model BoqLine {
  id              String         @id
  boqId           String
  catalogueItemId String?
  description     String
  quantity        Decimal        @db.Decimal(14, 4)
  unit            String
  unitPriceMinor  BigInt
  labourMinor     BigInt         @default(0)
  materialMinor   BigInt         @default(0)
  taxRateBps      Int            @default(0)
  wastageBps      Int            @default(0)
  discountMinor   BigInt         @default(0)
  lineTotalMinor  BigInt
  boq             Boq            @relation(fields: [boqId], references: [id], onDelete: Cascade)
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@index([boqId])
}

model Package {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  priceMinor   BigInt
  currency     String        @default("INR")
  credits      Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  purchases    Purchase[]
  entitlements Entitlement[]
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  packageId       String
  status          PurchaseStatus @default(CREATED)
  amountMinor     BigInt
  // Real, auditable breakdown of how amountMinor was actually computed -
  // never a black-box final number. discountMinor is the real referral
  // discount applied (0 if none was eligible); platformFeeMinor/gstMinor
  // are the real, structured charges from quotationCharges.ts;
  // voluntaryContributionMinor is whatever the customer chose to add,
  // genuinely optional. amountMinor = package price - discount +
  // platform fee + GST + voluntary contribution, always reconstructable
  // from these real, stored components.
  discountMinor              BigInt   @default(0)
  platformFeeMinor           BigInt   @default(0)
  gstMinor                   BigInt   @default(0)
  voluntaryContributionMinor BigInt   @default(0)
  currency        String         @default("INR")
  provider        String?
  providerOrderId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  package         Package        @relation(fields: [packageId], references: [id])
  payment         Payment?
  entitlements    Entitlement[]

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id
  purchaseId        String        @unique
  status            PaymentStatus @default(CREATED)
  providerPaymentId String?       @unique
  amountMinor       BigInt
  currency          String
  signature         String?
  rawEventHash      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  purchase          Purchase      @relation(fields: [purchaseId], references: [id])

  @@index([status, createdAt])
}

model Entitlement {
  id                 String            @id @default(cuid())
  userId             String
  purchaseId         String?
  packageId          String
  status             EntitlementStatus @default(ACTIVE)
  creditsTotal       Int
  creditsReserved    Int               @default(0)
  creditsConsumed    Int               @default(0)
  idempotencyKey     String
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id])
  purchase           Purchase?         @relation(fields: [purchaseId], references: [id])
  package            Package           @relation(fields: [packageId], references: [id])
  creditReservations CreditReservation[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
}

model CreditReservation {
  id             String            @id @default(cuid())
  entitlementId  String
  credits        Int
  idempotencyKey String            @unique
  status         ReservationStatus @default(RESERVED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  entitlement    Entitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// Phase 1 Step 2 market-intelligence persistence parity.
// Foreign-key columns intentionally remain scalar here; the existing additive
// migrations own database constraints while services own authorization and
// cross-entity invariants.
model MarketSource {
