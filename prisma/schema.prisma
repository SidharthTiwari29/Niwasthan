  sourceId         String
  vendorId         String?
  productId        String
  sourceProductId  String
  sku              String?
  url              String?
  titleObserved    String?
  variant          Json?
  sourceAttributes Json?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
